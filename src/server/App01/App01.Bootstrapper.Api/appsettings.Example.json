{
  "AllowedHosts": "*",
  "Env": "PROD",
  "Tokens": {
    "X-TOKEN": ""
  },
  "ApiVersion": "1.0.0",
  "ApiUrl": "https://sever/api",
  "ConnectionStrings": {
    "DefaultConnection": "<ustaw connStrings>"
  },
  "Jwt": {
    "Key": "<ustaw w user-secrets>",
    "Issuer": "App01",
    "Audience": "App01",
    "ExpiryInMinutes": 1440
  },
  "Swagger": {
    "Enable": false,
    "Title": "App01 Server API",
    "Description": "API for App01 Server",
    "Contact": {
      "Name": "App01 Support",
      "Email": "contact@tomsoft1.pl"
    }
  },
  "LottoOpenApi": {
    "Url": "https://developers.lotto.pl",
    "ApiKey": "<ustaw w user-secrets>"
  },
  "OpenRouter": {
    "Url": "https://openrouter.ai/api/v1/chat/completions",
    "ApiKey": "<ustaw w user-secrets>",
    "Model": "google/gemini-3.5-flash-lite"
  },  
  "Workers": {
    "ApiWorker01Ping": {
      "Enabled": true,
      "IntervalMinutes": 5.0
    },
    "LottoWorker01": {
      "Enabled": false,
      "StartTime": "00:00:00",
      "EndTime": "23:59:59",
      "IntensiveBackupHours": [ 2, 6, 12, 18, 22 ],
      "IntensiveEveningHours": [ 13, 14, 15, 21, 22, 23 ],
      "IntervalMinutes": 30.0
    },
    "LottoWorker02": {
      "Enabled": false,
      "AfterDate": "2026-01-01T00:00:00",
      "IntervalMinutes": 0.05,
      "FreezingMinutes": 1
    },
    "LottoWorker03": {
      "Enabled": false,
      "IntervalMinutes": 0.05,
      "FreezingMinutes": 1
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.AspNetCore": "Error",
        "Microsoft.EntityFrameworkCore": "Error",
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/applog-.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "ApplicationName": "App01.Api"
    }
  }
}